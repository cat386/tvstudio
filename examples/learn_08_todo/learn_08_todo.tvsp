format = "tvstudio-project"
version = 1
name = "learn_08_todo"
forms = []
open_files = ["src/main.rs"]

[app]
title = "learn_08_todo"
russian = true
startup_form = ""
menu = []

[[app.status]]
text = "~Ins~ Добавить"
key = "Ins"
command = "CM_ADD"

[[app.status]]
text = "~F4~ Сделано"
key = "F4"
command = "CM_DONE"

[[app.status]]
text = "~Del~ Удалить"
key = "Del"
command = "CM_DELETE"

[[app.status]]
text = "~F3~ Новый список"
key = "F3"
command = "CM_NEW_LIST"

[[app.status]]
text = "~Alt-X~ Выход"
key = "Alt+X"
command = "cm::QUIT"

[[app.status]]
text = ""
key = "F6"
command = "cm::NEXT"

[[app.status]]
text = ""
key = "Alt+F3"
command = "cm::CLOSE"

[[app.commands]]
name = "CM_ADD"
value = 100
action = ""
comment = ""

[[app.commands]]
name = "CM_DONE"
value = 101
action = ""
comment = ""

[[app.commands]]
name = "CM_DELETE"
value = 102
action = ""
comment = ""

[[app.commands]]
name = "CM_NEW_LIST"
value = 103
action = ""
comment = ""
