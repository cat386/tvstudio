format = "tvstudio-project"
version = 1
name = "lfm"
forms = ["sort", "find", "run_and_show", "run_job", "choose", "input_box_hist", "run_search"]
open_files = ["src/main.rs"]

[app]
title = "lfm"
russian = true
startup_form = ""
menu = []

[[app.status]]
text = "~F1~ Справка"
key = "F1"
command = "CM_HELP_KEYS"

[[app.status]]
text = "~F2~ Имя"
key = "F2"
command = "CM_RENAME"

[[app.status]]
text = "~F3~ Просм"
key = "F3"
command = "CM_VIEW"

[[app.status]]
text = "~F4~ Правка"
key = "F4"
command = "CM_EDIT"

[[app.status]]
text = "~F5~ Копия"
key = "F5"
command = "CM_COPY"

[[app.status]]
text = "~F6~ Перен"
key = "F6"
command = "CM_MOVE"

[[app.status]]
text = "~F7~ Папка"
key = "F7"
command = "CM_MKDIR"

[[app.status]]
text = "~F8~ Удал"
key = "F8"
command = "CM_DELETE"

[[app.status]]
text = "~F9~ Меню"
key = "F9"
command = "cm::MENU"

[[app.status]]
text = "~F10~ Выход"
key = "F10"
command = "cm::QUIT"

[[app.commands]]
name = "CM_RENAME"
value = 100
action = ""
comment = ""

[[app.commands]]
name = "CM_VIEW"
value = 101
action = ""
comment = ""

[[app.commands]]
name = "CM_EDIT"
value = 102
action = ""
comment = ""

[[app.commands]]
