format = "tvstudio-project"
version = 1
name = "demo"
forms = ["dialog"]
open_files = ["src/main.rs"]

[app]
title = "demo"
russian = false
startup_form = ""

[[app.menu]]
title = "~Ф~айл"

[[app.menu.items]]
title = "~Н~овое окно"
command = "cm::NEW"
key = "F2"
help = 0

[[app.menu.items]]
title = "~С~писок"
command = "CM_LIST"
key = "F3"
help = 0

[[app.menu.items]]
separator = true

[[app.menu.items]]
title = "~В~ыход"
command = "cm::QUIT"
key = "Alt-X"
help = 0

[[app.menu]]
title = "~Д~иалоги"

[[app.menu.items]]
