format = "tvstudio-project"
version = 1
name = "hello"
forms = ["greeting"]
open_files = ["src/main.rs"]

[app]
title = "hello"
russian = false
startup_form = ""

[[app.menu]]
title = "~H~ello"

[[app.menu.items]]
title = "~G~reeting..."
command = "GREET_THEM_CMD"
key = "Alt-G"
help = 0

[[app.menu.items]]
separator = true

[[app.menu.items]]
title = "E~x~it"
command = "cm::QUIT"
key = "Alt-X"
help = 0

[[app.status]]
text = "~Alt-X~ Exit"
key = "Alt+X"
command = "cm::QUIT"

[[app.status]]
text = ""
key = "F10"
command = "cm::MENU"

[[app.commands]]
name = "GREET_THEM_CMD"
value = 100
action = ""
comment = "Своя команда приложения (`GreetThemCmd`)."
