format = "tvstudio-project"
version = 1
name = "guide_contacts"
forms = ["contact_dialog"]
open_files = ["src/main.rs"]

[app]
title = "guide_contacts"
russian = false
startup_form = ""

[[app.menu]]
title = "~Ф~айл"

[[app.menu.items]]
title = "~Н~овый"
command = "cm::NEW"
key = ""
help = 0

[[app.menu.items]]
title = "~О~ткрыть..."
command = "cm::OPEN"
key = "F3"
help = 0

[[app.menu.items]]
title = "~С~охранить"
command = "cm::SAVE"
key = "F2"
help = 0

[[app.menu.items]]
title = "Сохранить ~к~ак..."
command = "cm::SAVE_AS"
key = ""
help = 0

[[app.menu.items]]
separator = true

[[app.menu.items]]
title = "~В~ыход"
command = "CM_EXIT"
key = "Alt-X"
help = 0

[[app.menu]]
title = "~К~онтакт"

[[app.menu.items]]
title = "~Д~обавить..."
command = "CM_ADD"
key = "Ins"
help = 0

[[app.menu.items]]
title = "~И~зменить..."
command = "CM_EDIT"
key = "F4"
help = 0

[[app.menu.items]]
title = "~У~далить"
command = "CM_DELETE"
key = "Del"
help = 0

[[app.menu.items]]
separator = true

[[app.menu.items]]
title = "~С~ортировать по имени"
command = "CM_SORT"
key = ""
help = 0

[[app.status]]
text = "~Ins~ Добавить"
key = "Ins"
command = "CM_ADD"

[[app.status]]
text = "~F4~ Изменить"
key = "F4"
command = "CM_EDIT"

[[app.status]]
text = "~Del~ Удалить"
key = "Del"
command = "CM_DELETE"

[[app.status]]
text = "~F2~ Сохранить"
key = "F2"
command = "cm::SAVE"

[[app.status]]
text = "~Alt-X~ Выход"
key = "Alt+X"
command = "CM_EXIT"

[[app.status]]
text = ""
key = "F10"
command = "cm::MENU"

